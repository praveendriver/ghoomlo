# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgres://ghoomlo:ghoomlo@localhost:5432/ghoomlo
# Used only by `npm test`; tests wipe this database.
TEST_DATABASE_URL=postgres://ghoomlo:ghoomlo@localhost:5432/ghoomlo_test
# Required for itinerary generation. Without it the rest of the app still works.
ANTHROPIC_API_KEY=
# Set to "off" to skip the OpenStreetMap place search that puts pins on plan maps.
GEOCODING=
# Microsoft Clarity project ID. Leave empty to turn session recording off.
CLARITY_PROJECT_ID=
# Comma-separated emails of accounts allowed to open /admin/fare-watch.
# Create the account on the site FIRST, then list its email here: sign-up does not
# verify email ownership, so an unclaimed address listed here could be registered by anyone.
ADMIN_EMAILS=
