<script src="../_shared/data-sources.js"></script>
<script src="../_shared/claude-agent.js"></script>
<script src="../_shared/agent-toast.js"></script>
<script src="../_shared/trip-map.js"></script>
<script src="../_shared/site.js"></script>
<script>
  // Pin button for this trip page
  document.addEventListener('DOMContentLoaded', () => {
    const PIN_KEY = 'yatra:pinned-trips';
    const btn = document.getElementById('trip-pin-btn');
    if (!btn) return;
    const id = btn.dataset.pinId;
    const get = () => { try { return JSON.parse(localStorage.getItem(PIN_KEY) || '[]'); } catch (_) { return []; } };
    const sync = () => {
      const list = get();
      const isPinned = list.includes(id);
      btn.classList.toggle('pinned', isPinned);
      const tip = isPinned ? 'Unpin trip' : 'Pin trip';
      btn.setAttribute('aria-label', tip);
      btn.setAttribute('title', tip);
    };
    btn.addEventListener('click', () => {
      const list = get();
      const idx = list.indexOf(id);
      if (idx === -1) list.push(id); else list.splice(idx, 1);
      localStorage.setItem(PIN_KEY, JSON.stringify(list));
      sync();
    });
    sync();
  });

  // Post-trip prompt copy
  function copyPostPrompt() {
    const txt = document.getElementById('post-trip-prompt').innerText;
    navigator.clipboard.writeText(txt).then(() => {
      const s = document.getElementById('post-copy-state');
      s.textContent = '✓ Copied — paste into Claude Code in ~/projects/personal/travel agent';
      s.style.color = 'var(--saffron-deep)';
      setTimeout(() => { s.textContent = ''; }, 4000);
    });
  }

  // Curator's Picks — must-do/must-eat/must-buy/unique blocks per city
  (async function renderCuratorPicks() {
    const root = document.getElementById('curator-picks-root');
    if (!root || !window.YatraData || !YatraData.CuratorsPicks) return;
    const cities = ['Tokyo', 'Kyoto', 'Hakone'];
    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    const labels = {
      must_do:           { title: 'Must do',         icon: '◈' },
      must_eat:          { title: 'Must eat',        icon: '◉' },
      must_buy:          { title: 'Must buy',        icon: '◆' },
      unique_experience: { title: 'Unique to here',  icon: '✦' },
    };
    function pickAttribution(p) {
      const bits = [];
      if (p.creator_count > 0) bits.push(`${p.creator_count} creator${p.creator_count > 1 ? 's' : ''}`);
      if (p.tripadvisor && p.tripadvisor.rating) {
        bits.push(`★ ${p.tripadvisor.rating}`);
      }
      if (p.tripadvisor && p.tripadvisor.ranking) {
        const m = String(p.tripadvisor.ranking).match(/#(\d+)/);
        if (m) bits.push(`#${m[1]} ranked`);
      }
      if (p.is_seed && p.creator_count === 0) bits.push('Editorial pick');
      return bits.join(' · ');
    }
    function pickCard(p) {
      const ta = p.tripadvisor || {};
      const taLink = ta.url ? `<a class="tripadvisor-rating-pill" href="${ta.url}" target="_blank" rel="noopener" title="${escapeHtml(ta.ranking || '')}">TripAdvisor ★ ${escapeHtml(ta.rating || '')}${ta.review_count ? ' · ' + Number(ta.review_count).toLocaleString('en-IN') : ''}</a>` : '';
      const quote = p.quote && p.quote.length >= 20
        ? `<blockquote class="curator-quote">"${escapeHtml(p.quote.slice(0, 180))}${p.quote.length > 180 ? '…' : ''}"<cite>— ${escapeHtml(p.quote_creator || 'creator')}${p.quote_url ? ` <a href="${p.quote_url}" target="_blank" rel="noopener">↗</a>` : ''}</cite></blockquote>`
        : '';
      const attr = pickAttribution(p);
      return `
        <article class="curator-card">
          <div class="curator-card-head">
            <div class="curator-card-name">${escapeHtml(p.name)}</div>
            ${attr ? `<div class="curator-card-attr">${attr}</div>` : ''}
          </div>
          ${quote}
          <div class="curator-card-foot">
            ${taLink}
            <a href="https://www.google.com/maps/search/${encodeURIComponent(p.name + ' ' + (p.city || ''))}" target="_blank" rel="noopener">Map ↗</a>
          </div>
        </article>`;
    }
    const blocks = [];
    for (const city of cities) {
      const data = await YatraData.CuratorsPicks.forDestination(city);
      if (!data || !data.buckets) continue;
      const totalPicks = Object.values(data.buckets).reduce((a, b) => a + b.length, 0);
      if (!totalPicks) continue;
      const buckets = ['must_do', 'must_eat', 'must_buy', 'unique_experience']
        .filter((k) => (data.buckets[k] || []).length)
        .map((k) => `
          <div class="curator-bucket">
            <h4 class="curator-bucket-head"><span class="curator-bucket-icon">${labels[k].icon}</span> ${labels[k].title}</h4>
            <div class="curator-bucket-grid">
              ${data.buckets[k].map(pickCard).join('')}
            </div>
          </div>`).join('');
      blocks.push(`
        <div class="curator-city">
          <h3 class="curator-city-head">${escapeHtml(city)} <span class="curator-city-meta">${data.creators_total} creators · ${totalPicks} picks</span></h3>
          ${buckets}
        </div>`);
    }
    if (!blocks.length) {
      root.innerHTML = '<div class="influencer-empty">No curator picks cached yet. Run <code>scripts/influencers/synthesizer.py --all</code> to populate.</div>';
      return;
    }
    root.innerHTML = blocks.join('');
    // Stamp data-lat/lon on each curator card so they are clickable into the map.
    try {
      if (YatraData.Influencers && YatraData.Influencers._loadAll) {
        const payload = await YatraData.Influencers._loadAll();
        const lookup = {};
        (payload.items || []).forEach((it) => {
          (it.places_mentioned || []).forEach((pm) => {
            if (typeof pm.lat === 'number' && typeof pm.lon === 'number' && pm.name) {
              const k = pm.name.toLowerCase().trim();
              if (!lookup[k]) lookup[k] = { lat: pm.lat, lon: pm.lon };
            }
          });
        });
        const tripCities = (window.YATRA_TRIP_DEFAULTS && window.YATRA_TRIP_DEFAULTS.cities) || [];
        root.querySelectorAll('.curator-card').forEach((card) => {
          const nameEl = card.querySelector('.curator-card-name');
          if (!nameEl) return;
          const name = nameEl.textContent.trim();
          const cityWrap = card.closest('.curator-city');
          const cityHeadEl = cityWrap ? cityWrap.querySelector('.curator-city-head') : null;
          const cityName = cityHeadEl ? cityHeadEl.firstChild.textContent.trim() : null;
          let coords = lookup[name.toLowerCase()];
          if (!coords && cityName) {
            const matched = tripCities.find((c) => c.name.toLowerCase() === cityName.toLowerCase());
            if (matched) coords = { lat: matched.lat, lon: matched.lon };
          }
          if (!coords) return;
          card.setAttribute('data-map-scope', 'curator');
          card.setAttribute('data-lat', String(coords.lat));
          card.setAttribute('data-lon', String(coords.lon));
          card.setAttribute('data-name', name);
          card.setAttribute('tabindex', '0');
          card.setAttribute('role', 'button');
        });
      }
    } catch (_) { /* fall through silently */ }
    if (window.TripMap && typeof window.TripMap.refresh === 'function') window.TripMap.refresh();
  })();

  // Influencer voices: render quotes from corpus
  (async function renderInfluencerVoices() {
    const grid = document.getElementById('influencer-voices-grid');
    const topPlacesRoot = document.getElementById('influencer-top-places');
    if (!grid || !window.YatraData || !YatraData.Influencers) return;
    const cities = ['Tokyo', 'Kyoto', 'Hakone'];
    const seen = new Set();
    const merged = [];
    for (const city of cities) {
      const items = await YatraData.Influencers.forDestination(city, 12);
      for (const it of items) {
        if (seen.has(it.id)) continue;
        seen.add(it.id);
        merged.push({ ...it, _city: city });
      }
    }
    if (!merged.length) {
      grid.innerHTML = '<div class="influencer-empty">No creator content cached yet for these cities. Run <code>scripts/influencers/corpus_builder.py --for-destination Tokyo</code> to populate.</div>';
      return;
    }

    // Top recommended places: aggregate across creators, score by mention count + sentiment
    const placeScores = new Map();
    merged.forEach((it) => {
      (it.places_mentioned || []).forEach((p) => {
        if (!p.name) return;
        const key = p.name;
        const e = placeScores.get(key) || { name: p.name, mentions: 0, positive: 0, negative: 0, creators: new Set(), city: p.city, firstQuote: null, firstUrl: null, firstCreator: null };
        e.mentions += 1;
        if (p.sentiment === 'positive') e.positive += 1;
        if (p.sentiment === 'negative') e.negative += 1;
        e.creators.add(it.creator);
        if (!e.firstQuote && p.quote) { e.firstQuote = p.quote; e.firstUrl = it.url; e.firstCreator = it.creator; }
        placeScores.set(key, e);
      });
    });
    const ranked = [...placeScores.values()]
      .filter((p) => p.creators.size >= 1)
      .sort((a, b) => (b.creators.size * 2 + b.positive - b.negative) - (a.creators.size * 2 + a.positive - a.negative))
      .slice(0, 6);
    if (ranked.length && topPlacesRoot) {
      topPlacesRoot.innerHTML = `
        <h3 class="influencer-top-heading">Most-recommended places by creators</h3>
        <div class="influencer-top-grid">
          ${ranked.map((p) => `
            <article class="top-place-card">
              <div class="top-place-name">${escapeHtml(p.name)}</div>
              <div class="top-place-meta">
                <span class="creator-count-pill">${p.creators.size} creator${p.creators.size === 1 ? '' : 's'}</span>
                ${p.positive ? `<span class="sentiment-pill positive">${p.positive}+</span>` : ''}
                ${p.negative ? `<span class="sentiment-pill negative">${p.negative}-</span>` : ''}
              </div>
              ${p.firstQuote ? `<blockquote class="top-place-quote">"${escapeHtml(p.firstQuote.slice(0, 160))}${p.firstQuote.length > 160 ? '…' : ''}"</blockquote>` : ''}
              <div class="top-place-foot">
                ${p.firstCreator ? `<span class="ink-mute">— ${escapeHtml(p.firstCreator)}</span>` : ''}
                <a href="https://www.google.com/maps/search/${encodeURIComponent(p.name + (p.city ? ' ' + p.city : ''))}" target="_blank" rel="noopener">Map ↗</a>
              </div>
              <div class="top-place-ta" data-ta-place="${escapeHtml(p.name)}" data-ta-city="${escapeHtml(p.city || '')}"></div>
            </article>
          `).join('')}
        </div>`;
      // Async TripAdvisor fetch for each — uses YATRA_TRIP_DEFAULTS for geo filter.
      ranked.forEach(async (p) => {
        const slot = document.querySelector(`.top-place-ta[data-ta-place="${CSS.escape(p.name)}"]`);
        if (!slot || !YatraData.TripAdvisor) return;
        const defaults = window.YATRA_TRIP_DEFAULTS || {};
        const cityEntry = (defaults.cities || []).find((c) => c.name === p.city) || (defaults.cities || [])[0] || {};
        const ta = await YatraData.TripAdvisor.search({
          query: p.name,
          type: 'attraction',
          country: defaults.country,
          city: cityEntry.name,
          lat: cityEntry.lat,
          lon: cityEntry.lon,
        });
        if (!ta || !ta.rating) return;
        slot.innerHTML = `
          <a class="tripadvisor-rating-pill" href="${ta.url}" target="_blank" rel="noopener" title="${escapeHtml(ta.ranking || '')}">
            TripAdvisor ★ ${escapeHtml(ta.rating)}${ta.review_count ? ' · ' + Number(ta.review_count).toLocaleString('en-IN') : ''}
          </a>`;
      });
    }
    function pickQuote(item) {
      // GUARDRAIL: only surface excerpts that mention a specific place.
      // No more raw transcript fallbacks — those produced "(no excerpt)" or
      // off-topic Hindi/Turkey excerpts.
      const place = (item.places_mentioned || [])[0];
      if (place && place.quote && place.quote.length >= 30) {
        return { quote: place.quote, sentiment: place.sentiment, place: place.name, lat: place.lat, lon: place.lon };
      }
      return null;
    }
    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    const cards = merged
      .map((it) => ({ it, q: pickQuote(it) }))
      .filter((x) => x.q)
      .slice(0, 8);
    if (!cards.length) {
      grid.innerHTML = '<div class="influencer-empty">No place-specific creator excerpts cached yet for these cities. The pipeline drops items without recognised place mentions to keep this section trustworthy. Re-run <code>scripts/influencers/corpus_builder.py --for-destination Tokyo --whisper-fallback</code>.</div>';
      return;
    }
    grid.innerHTML = cards.map(({ it, q }) => {
      const sentClass = q.sentiment === 'positive' ? 'positive' : q.sentiment === 'negative' ? 'negative' : 'neutral';
      const placeNote = q.place ? `· <strong>${escapeHtml(q.place)}</strong>` : '';
      const datePart = it.published ? new Date(it.published).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) : '';
      const hasCoords = typeof q.lat === 'number' && typeof q.lon === 'number';
      const cardAttrs = hasCoords
        ? ` data-map-scope="creators" data-lat="${q.lat}" data-lon="${q.lon}" data-name="${escapeHtml(q.place || '')}" tabindex="0" role="button"`
        : '';
      return `
        <article class="influencer-card"${cardAttrs}>
          <div class="creator-row">
            <span class="creator-badge">${escapeHtml(it.creator || 'Unknown')}</span>
            <span class="creator-source">${escapeHtml(it.source || '')}</span>
          </div>
          <blockquote class="influencer-quote compact">${escapeHtml(q.quote)}</blockquote>
          <div class="influencer-meta">
            <span class="sentiment-pill ${sentClass}">${q.sentiment}</span>
            <span>${escapeHtml(it._city)}</span>${placeNote ? ' ' + placeNote : ''}
            ${datePart ? `<span>· ${datePart}</span>` : ''}
            ${it.url ? `<a href="${it.url}" target="_blank" rel="noopener">Source ↗</a>` : ''}
          </div>
        </article>`;
    }).join('');
    if (window.TripMap && typeof window.TripMap.refresh === 'function') window.TripMap.refresh();
  })();
</script>

</body>
</html>
