<script>
  window.YATRA_TRIP_DEFAULTS = {
    country: 'JP',
    cities: [
      { name: 'Tokyo',  lat: 35.68, lon: 139.77 },
      { name: 'Kyoto',  lat: 35.01, lon: 135.77 },
      { name: 'Hakone', lat: 35.23, lon: 139.02 },
