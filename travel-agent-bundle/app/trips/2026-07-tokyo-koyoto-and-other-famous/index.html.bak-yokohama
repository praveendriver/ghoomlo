      <div class="anchor-card-wrap kind-food">
        <div class="anchor-card">
          <div class="anchor-head">
            <div>
              <div class="name">Tea + sweets ritual</div>
              <div class="where">Kyoto · Uji · Arashiyama</div>
            </div>
            <span class="anchor-kind">Experience</span>
          </div>
          <hr class="anchor-divider">
          <div class="anchor-section-label">What to expect</div>
          <ul class="anchor-checklist">
            <li>Wagashi (rice + bean sweets) + matcha</li>
            <li>Camellia Garden — kid-friendly 45-min ceremony</li>
            <li>Nakatanidou (Nara) — live mochi-pounding demo</li>
            <li>Entertainment + snack rolled into one</li>
          </ul>
          <div class="anchor-meta">
