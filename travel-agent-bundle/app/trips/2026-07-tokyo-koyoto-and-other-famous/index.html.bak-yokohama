<!-- ========== MUST-INCLUDE (ADD-TO-NEXT-REFRESH) ========== -->
<section class="must-include" id="must-include">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">Add items · Your cart</div>
        <h2>Build the trip <em>around what you actually want</em></h2>
      </div>
      <p>Hover any card on this page (restaurants, hotels, anchors, day rows, route segments, the two paths) and click <strong>+</strong> to drop it in your cart below. Or use the chip inputs to type new items, paste comma-separated lists, or paste a YouTube / Instagram / TripAdvisor / blog URL — the planner will fetch + transcribe it and extract every place mentioned. In the cart, drag to reorder and set <strong>Day + Time</strong> per item, or leave on "AI decides" and the planner will sequence everything by proximity, time saved, traveller effort, and cost. Hit <strong>Refresh with these items</strong> to rebuild this page around your cart — existing suggestions that don't fit the new flow are dropped. Items that genuinely can't be included show up in a callout at the top of the itinerary with the reason. Saved per-trip in this browser.</p>
    </div>

    <div class="mi-card">
      <div class="mi-grid">
        <div class="mi-category" data-mi-category="places">
          <div class="mi-category-label">Places to visit</div>
          <div class="mi-chip-input">
            <input type="text" placeholder="Type and press Enter — e.g. Yanaka Ginza" autocomplete="off">
          </div>
        </div>
        <div class="mi-category" data-mi-category="todo">
          <div class="mi-category-label">Things to do</div>
          <div class="mi-chip-input">
            <input type="text" placeholder="Type and press Enter — e.g. Sumo morning practice" autocomplete="off">
          </div>
        </div>
        <div class="mi-category" data-mi-category="buy">
          <div class="mi-category-label">Things to buy</div>
          <div class="mi-chip-input">
            <input type="text" placeholder="Type and press Enter — e.g. Don Quijote run" autocomplete="off">
          </div>
        </div>
        <div class="mi-category" data-mi-category="eat">
          <div class="mi-category-label">Things to eat</div>
          <div class="mi-chip-input">
            <input type="text" placeholder="Type or paste comma-separated — e.g. T's Tantan, Afuri vegan ramen" autocomplete="off">
          </div>
        </div>
      </div>

      <div class="mi-category mi-category--full" data-mi-category="links">
        <div class="mi-category-label">Source links — YouTube · Instagram · TripAdvisor · blog</div>
        <div class="mi-chip-input">
          <input type="url" placeholder="Paste a URL and press Enter — the planner will fetch, transcribe, and extract place names" autocomplete="off">
        </div>
        <div class="mi-help">YouTube videos are auto-transcribed (Whisper fallback if no captions). Every place mentioned in a parsed source is researched and slotted just like a typed item.</div>
      </div>

      <div class="mi-notes">
        <label class="mi-category-label" for="mi-notes">Notes / context (optional)</label>
        <textarea id="mi-notes" placeholder="Anything the planner should know — e.g. 'avoid 5am temple visits', 'kids loved Owakudani last time'"></textarea>
      </div>

      <div class="mi-actions">
        <button class="btn btn-saffron btn-sm" id="mi-submit">
          <svg class="icon icon-sm"><use href="#i-refresh"/></svg>
          Refresh with these items
        </button>
        <span class="mi-status" id="mi-status"></span>
      </div>
    </div>
  </div>
</section>

