      <div class="anchor-card-wrap kind-food">
        <div class="anchor-card">
          <div class="anchor-head">
            <div>
              <div class="name">Shigetsu · Tenryu-ji</div>
              <div class="where">Kyoto · Arashiyama</div>
            </div>
            <span class="anchor-kind">Restaurant</span>
          </div>
          <hr class="anchor-divider">
          <div class="anchor-section-label">What to request at booking</div>
          <ul class="anchor-checklist">
            <li>Shojin ryori (Zen Buddhist vegetarian) set lunch</li>
            <li>Reserve a day ahead — inside the Tenryu-ji temple garden</li>
