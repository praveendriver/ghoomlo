<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gama Adventures — Japan: Tokyo · Kyoto · Mt. Fuji · Jul 13–24, 2026</title>
<link rel="icon" type="image/svg+xml" href="../_shared/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=Srisakdi:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../_shared/style.css">
<style>

  /* Trip-page specific */
  .hero {
    position: relative;
    padding: 80px 0 100px;
    background:
      radial-gradient(ellipse 80% 60% at 70% 20%, rgba(217, 122, 58, 0.10), transparent 60%),
      radial-gradient(ellipse 70% 50% at 20% 80%, rgba(31, 58, 61, 0.08), transparent 60%);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
  }
  .hero h1 { font-size: clamp(48px, 6vw, 84px); margin-bottom: 28px; }
  .hero-sub {
    font-size: 19px; color: var(--ink-soft);
    margin-bottom: 40px; max-width: 480px;
  }
  .hero-meta {
    display: grid; grid-template-columns: repeat(4, auto); gap: 36px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 36px;
  }
  .meta-item .label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-soft); margin-bottom: 6px;
  }
  .meta-item .value {
    font-family: 'Fraunces', serif; font-size: 22px; font-weight: 500;
  }
  .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

  .hero-visual { position: relative; height: 560px; }
  .h-card {
    position: absolute;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    color: var(--cream);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
    display: flex;
    flex-direction: column;
  }
  .h-card:hover { transform: translateY(-6px) scale(1.02); }
  .h-card-1 { width: 290px; height: 380px; top: 20px; right: 60px; }
  .h-card-2 { width: 240px; height: 320px; bottom: 20px; left: 0; }
  .h-card-img { width: 100%; flex: 1 1 auto; position: relative; min-height: 0; }
  .h-card-1 .h-card-img {
    background-image: url('https://images.pexels.com/photos/13621055/pexels-photo-13621055.jpeg?auto=compress&cs=tinysrgb&w=600');
    background-size: cover;
    background-position: center;
  }
  .h-card-2 .h-card-img {
    background-image: url('https://images.pexels.com/photos/36530015/pexels-photo-36530015.jpeg?auto=compress&cs=tinysrgb&w=600');
    background-size: cover;
    background-position: center;
  }
  .h-card-img::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.45) 100%);
  }
  .h-card-tag {
    position: absolute; top: 18px; right: 18px;
    background: rgba(255,255,255,0.92); color: var(--ink);
    padding: 6px 12px; border-radius: 999px;
    font-size: 11px; font-weight: 600;
    backdrop-filter: blur(10px);
  }
  .h-card-body { padding: 18px 22px; background: var(--ink); flex: 0 0 auto; }
  .h-card-body .place {
    font-family: 'Fraunces', serif; font-size: 22px; font-weight: 500;
    margin-bottom: 4px;
  }
  .h-card-body .meta { font-size: 13px; opacity: 0.7; }

  .hero-decor {
    position: absolute; top: 50%; left: -40px;
    transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 24px;
    z-index: 1;
  }
  .hero-decor .ring {
    width: 12px; height: 12px; border-radius: 50%;
    border: 2px solid var(--ink);
  }
  .hero-decor .ring.filled { background: var(--ink); }
  .hero-decor .line { width: 2px; height: 60px; background: var(--ink); margin-left: 5px; }

  /* ---------- HERO IMAGE STRIP ---------- */
  .strip {
    padding: 60px 0 40px;
    overflow: hidden;
    position: relative;
  }
  .strip-eyebrow {
    text-align: center;
    margin-bottom: 24px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--saffron);
    font-weight: 600;
  }
  .strip-track {
    display: flex;
    gap: 18px;
    width: max-content;
    animation: strip-scroll 60s linear infinite;
    will-change: transform;
  }
  .strip:hover .strip-track { animation-play-state: paused; }
  @keyframes strip-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  /* Edge fade so the loop seam is invisible */
  .strip::before,
  .strip::after {
    content: '';
    position: absolute;
    top: 60px; bottom: 40px;
    width: 120px;
    z-index: 5;
    pointer-events: none;
  }
  .strip::before {
    left: 0;
    background: linear-gradient(to right, var(--cream) 0%, transparent 100%);
  }
  .strip::after {
    right: 0;
    background: linear-gradient(to left, var(--cream) 0%, transparent 100%);
  }
  .strip-card {
    flex: 0 0 auto;
    width: 280px;
    height: 360px;
    border-radius: var(--r-lg);
    overflow: hidden;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s;
  }
  .strip-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-lg);
  }
  .strip-card-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform .8s cubic-bezier(.2,.8,.2,1);
  }
  .strip-card:hover .strip-card-img { transform: scale(1.08); }
  .strip-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0,0,0,0.75) 100%);
  }
  .strip-card-meta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 22px;
    color: white;
    z-index: 2;
  }
  .strip-card-tag {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(10px);
    border-radius: 999px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .strip-card-tag.alt {
    background: rgba(255, 200, 130, 0.25);
  }
  .strip-card-name {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: 4px;
  }
  .strip-card-loc {
    font-size: 12px;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .strip-card { width: 220px; height: 300px; }
    .strip-card-name { font-size: 18px; }
    .strip-track { animation-duration: 40s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip-track { animation: none; }
  }

  /* ---------- COMPARE ---------- */
  .compare { padding: 100px 0; }
  .compare-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px;
  }
  .opt-card {
    background: var(--cream-dark);
    border-radius: var(--r-xl);
    padding: 8px;
    transition: transform .3s;
  }
  .opt-card.recommended {
    background: linear-gradient(135deg, #1f3a3d 0%, #122729 100%);
    color: var(--cream);
  }
  .opt-card-image {
    height: 240px;
    border-radius: 36px;
    background-size: cover; background-position: center;
    position: relative; overflow: hidden;
  }
  .opt-card.recommended .opt-card-image {
    background-image: url('https://images.pexels.com/photos/10271157/pexels-photo-10271157.jpeg?auto=compress&cs=tinysrgb&w=900');
    background-size: cover;
    background-position: center;
  }
  .opt-card:not(.recommended) .opt-card-image {
    background-image: url('https://images.pexels.com/photos/23601365/pexels-photo-23601365.jpeg?auto=compress&cs=tinysrgb&w=900');
    background-size: cover;
    background-position: center;
  }
  .opt-card-image::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.5) 100%);
  }
  .opt-badge {
    position: absolute; top: 20px; left: 20px;
    background: rgba(255,255,255,0.95); color: var(--ink);
    padding: 8px 14px; border-radius: 999px;
    font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    z-index: 2;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .opt-badge.rec { background: var(--saffron); color: white; }
  .opt-card-body { padding: 32px 28px 28px; }
  .opt-card h3 { font-size: 32px; margin-bottom: 6px; }
  .opt-card.recommended h3 { color: var(--cream); }
  .opt-card .opt-sub { font-size: 14px; color: var(--ink-soft); margin-bottom: 24px; }
  .opt-card.recommended .opt-sub { color: rgba(246, 241, 232, 0.65); }

  .opt-stats {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(0,0,0,0.08);
    border-bottom: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 24px;
  }
  .opt-card.recommended .opt-stats { border-color: rgba(246, 241, 232, 0.12); }
  .stat .stat-val {
    font-family: 'Fraunces', serif; font-size: 24px; font-weight: 500;
    margin-bottom: 4px;
  }
  .stat .stat-lbl {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .opt-card.recommended .stat-lbl { color: rgba(246, 241, 232, 0.6); }
  .opt-features { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .feature-pill {
    padding: 6px 14px;
    background: rgba(0,0,0,0.06);
    border-radius: 999px;
    font-size: 12px; color: var(--ink-soft);
  }
  .opt-card.recommended .feature-pill {
    background: rgba(246, 241, 232, 0.10);
    color: rgba(246, 241, 232, 0.85);
  }
  .feature-pill.warn { background: rgba(217, 122, 58, 0.15); color: var(--saffron); }
  .opt-link {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 500; color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 4px;
    transition: gap .2s;
  }
  .opt-card.recommended .opt-link {
    color: var(--saffron-soft); border-color: var(--saffron-soft);
  }
  .opt-link:hover { gap: 14px; }

  /* ---------- ITINERARY ---------- */
  .itinerary {
    padding: 100px 0;
    background: var(--ink);
    color: var(--cream);
    border-radius: var(--r-xl);
    margin: 0 32px 80px;
  }
  @media (min-width: 1300px) {
    .itinerary {
      margin-left: calc((100vw - 1240px) / 2 + 32px);
      margin-right: calc((100vw - 1240px) / 2 + 32px);
    }
  }
  .itinerary .section-eyebrow { color: var(--saffron-soft); }
  .itinerary h2 { color: var(--cream); }
  .itinerary .section-head p { color: rgba(246, 241, 232, 0.65); }

  .tabs {
    display: inline-flex;
    background: rgba(246, 241, 232, 0.08);
    border-radius: 999px;
    padding: 6px;
    margin-bottom: 56px;
  }
  .tab {
    padding: 12px 28px;
    background: transparent;
    color: rgba(246, 241, 232, 0.6);
    border: none; border-radius: 999px;
    font-size: 14px; font-weight: 500;
    transition: all .25s;
  }
  .tab.active {
    background: var(--cream); color: var(--ink);
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; animation: fadeIn .4s; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* timeline */
  .timeline { position: relative; padding-left: 60px; }
  .timeline::before {
    content: ''; position: absolute;
    left: 16px; top: 14px; bottom: 14px;
    width: 2px;
    background: linear-gradient(180deg, var(--saffron) 0%, var(--saffron) 90%, transparent 100%);
    opacity: 0.3;
  }
  .day {
    position: relative;
    margin-bottom: 24px;
    background: rgba(246, 241, 232, 0.04);
    border: 1px solid rgba(246, 241, 232, 0.08);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: all .3s;
  }
  .day:hover {
    background: rgba(246, 241, 232, 0.07);
    border-color: rgba(246, 241, 232, 0.15);
  }
  .day-marker {
    position: absolute; left: -52px; top: 22px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--saffron);
    display: flex; align-items: center; justify-content: center;
    color: var(--saffron-soft);
    z-index: 2;
  }
  .day-marker .icon { width: 16px; height: 16px; }
  .day summary {
    padding: 22px 28px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    list-style: none;
  }
  .day summary::-webkit-details-marker { display: none; }
  .day-head { flex: 1; display: flex; align-items: center; gap: 24px; }
  .day-date {
    font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: rgba(246, 241, 232, 0.55);
    min-width: 110px;
  }
  .day-title {
    font-family: 'Fraunces', serif;
    font-size: 22px; font-weight: 500;
    color: var(--cream);
  }
  .day-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .day-tag {
    padding: 3px 10px;
    background: rgba(217, 122, 58, 0.18);
    color: var(--saffron-soft);
    font-size: 11px;
    border-radius: 999px;
  }
  .chev {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(246, 241, 232, 0.06);
    display: inline-flex; align-items: center; justify-content: center;
    transition: transform .3s;
    flex-shrink: 0;
    color: var(--cream);
  }
  details[open] .chev { transform: rotate(180deg); }

  .day-body {
    padding: 0 28px 24px 28px;
    border-top: 1px solid rgba(246, 241, 232, 0.08);
  }

  /* day rows with icon glyph */
  .row {
    padding: 18px 0;
    display: grid;
    grid-template-columns: 100px 32px 1fr;
    gap: 18px;
    border-bottom: 1px solid rgba(246, 241, 232, 0.05);
    align-items: flex-start;
  }
  .row:last-child { border-bottom: none; }
  .row-time {
    font-family: 'Fraunces', serif;
    font-size: 16px; font-weight: 500;
    color: var(--saffron-soft);
    padding-top: 2px;
  }
  .row-icon {
    width: 32px; height: 32px;
    border-radius: 10px;
    background: rgba(246, 241, 232, 0.08);
    color: var(--saffron-soft);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .row-icon .icon { width: 16px; height: 16px; }
  .row-icon.transit { background: rgba(180, 200, 230, 0.15); color: #b8d4ee; }
  .row-icon.temple { background: rgba(217, 122, 58, 0.18); color: var(--saffron-soft); }
  .row-icon.food { background: rgba(200, 230, 180, 0.10); color: #c8e6b4; }
  .row-icon.hotel { background: rgba(232, 165, 114, 0.15); color: var(--saffron-soft); }
  .row-icon.outdoor { background: rgba(150, 200, 200, 0.15); color: #98d4d4; }
  .row-icon.shopping { background: rgba(210, 180, 230, 0.12); color: #d4b8e6; }

  .row-content {
    font-size: 15px;
    color: rgba(246, 241, 232, 0.85);
    line-height: 1.65;
  }
  .row-title { color: var(--cream); font-weight: 500; }
  .row-content .price {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 10px;
    background: rgba(246, 241, 232, 0.08);
    border-radius: 999px;
    font-size: 12px;
    color: rgba(246, 241, 232, 0.7);
  }

  /* ---------- COSTS ---------- */
  .costs { padding: 100px 0; }
  .costs-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px;
    margin-top: 48px;
  }
  .cost-card {
    background: white;
    border-radius: var(--r-lg);
    padding: 36px;
    box-shadow: var(--shadow-sm);
  }
  .cost-card.featured {
    background: linear-gradient(135deg, var(--saffron) 0%, var(--gold) 100%);
    color: white;
  }
  .cost-card h4 {
    font-size: 24px; font-weight: 500;
    margin-bottom: 6px;
  }
  .cost-card .cost-sub {
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 28px;
  }
  .cost-card.featured .cost-sub { color: rgba(255,255,255,0.85); }
  .cost-row {
    display: flex; justify-content: space-between;
    padding: 14px 0;
    font-size: 15px;
    border-bottom: 1px solid var(--line);
  }
  .cost-card.featured .cost-row { border-color: rgba(255,255,255,0.2); }
  .cost-row:last-child { border: none; }
  .cost-row.total {
    font-family: 'Fraunces', serif;
    font-size: 22px; font-weight: 500;
    margin-top: 12px; padding-top: 22px;
    border-top: 2px solid var(--ink);
  }
  .cost-card.featured .cost-row.total { border-color: rgba(255,255,255,0.3); }
  .cap-bar {
    height: 8px;
    background: var(--cream-dark);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 10px;
  }
  .cap-fill {
    height: 100%; background: var(--saffron);
    border-radius: 999px;
  }
  .cost-card.featured .cap-bar { background: rgba(255,255,255,0.25); }
  .cost-card.featured .cap-fill { background: white; }
  .cap-meta {
    display: flex; justify-content: space-between;
    font-size: 12px; margin-top: 8px;
    color: var(--ink-soft);
  }
  .cost-card.featured .cap-meta { color: rgba(255,255,255,0.85); }

  .loyalty-strip {
    margin-top: 56px;
    background: var(--ink);
    color: var(--cream);
    border-radius: var(--r-lg);
    padding: 48px;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .loyalty-strip h3 {
    font-size: 32px;
    color: var(--cream);
    margin-bottom: 16px;
  }
  .loyalty-strip p {
    color: rgba(246, 241, 232, 0.7);
    font-size: 15px;
    margin-bottom: 12px;
  }
  .loyalty-points {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  }
  .lp-item {
    background: rgba(246, 241, 232, 0.06);
    padding: 22px; border-radius: var(--r-sm);
  }
  .lp-prog {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    color: rgba(246, 241, 232, 0.5);
    margin-bottom: 10px;
  }
  .lp-bal {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    color: var(--saffron-soft);
    font-weight: 500;
    margin-bottom: 6px;
  }
  .lp-tier {
    font-size: 13px;
    color: rgba(246, 241, 232, 0.85);
  }

  /* ---------- TRANSPORT (CARS) ---------- */
  .transport { padding: 100px 0; background: var(--cream-dark); }
  .transport-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .car-card {
    background: var(--cream);
    border-radius: var(--r-lg);
    padding: 32px;
    transition: transform .25s, box-shadow .25s;
    display: flex; flex-direction: column;
  }
  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .car-head {
    display: flex; align-items: center; gap: 16px;
    margin-bottom: 20px;
  }
  .car-icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: var(--ink);
    color: var(--saffron-soft);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .car-icon .icon { width: 26px; height: 26px; }
  .car-head h4 {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .car-leg {
    font-size: 13px;
    color: var(--ink-soft);
  }
  .car-detail {
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 18px;
    line-height: 1.6;
  }
  .car-stats {
    display: flex; gap: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 18px;
  }
  .car-stat {
    flex: 1;
  }
  .car-stat-lbl {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }
  .car-stat-val {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    font-weight: 500;
  }
  .car-providers {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-top: auto;
  }
  .provider-link {
    display: inline-flex; align-items: center; gap: 6px;
